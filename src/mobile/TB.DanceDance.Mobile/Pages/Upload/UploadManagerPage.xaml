<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TB.DanceDance.Mobile.Library.Data.Models.Storage;assembly=TB.DanceDance.Mobile.Library"
             xmlns:upload="clr-namespace:TB.DanceDance.Mobile.Pages.Upload"
             x:DataType="upload:UploadManagerPageModel"
             x:Name="UploadManagerPageView"
             x:Class="TB.DanceDance.Mobile.Pages.Upload.UploadManagerPage">
    <ContentPage.Content>
        <StackLayout Margin="10" Spacing="10">
            <HorizontalStackLayout Spacing="10">
                <Switch IsToggled="{Binding UploadOnlyOnWiFi}" />
                <Label Text="Wysyłaj tylko przez WiFi"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Label Text="Postęp wysyłania jest wyświetlany w powiadomieniu. Aplikacja nie ma uprawnienień do ich wyświetlania. Kliknij przycisk aby pozwolić na wyświetlanie powiadomień. (Nie spamujemy :))"
                   IsVisible="{Binding NotificationBlocked}"
                   />
            <Button Text="Ustaw uprawnienia" IsVisible="{Binding NotificationBlocked}" Command="{Binding AskNotificationPermissionsCommand}"/>
            <RefreshView IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}">
                <ScrollView Margin="0,10,0,0">
                    <StackLayout
                        BindableLayout.ItemsSource="{Binding ToUpload}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:VideosToUpload">
                                <Border Padding="10"
                                        Width="0"
                                        Margin="0,10,0,0">
                                    <VerticalStackLayout Spacing="6">
                                        <HorizontalStackLayout>
                                            <CheckBox IsEnabled="False" IsChecked="{Binding Uploaded}" />
                                            <Label Text="{Binding FileName}" FontSize="20" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding State, StringFormat='Status: {0}'}" />
                                        <Label Text="{Binding LastError}"
                                               TextColor="{AppThemeBinding Light=DarkRed, Dark=LightPink}" />
                                        <ProgressBar Progress="{Binding Progress}" />
                                        <HorizontalStackLayout Spacing="8">
                                            <Button Text="Ponów"
                                                    IsVisible="{Binding CanRetry}"
                                                    Command="{Binding Source={x:Reference UploadManagerPageView}, Path=BindingContext.RetryCommand}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Text="Anuluj"
                                                    IsVisible="{Binding CanCancel}"
                                                    Command="{Binding Source={x:Reference UploadManagerPageView}, Path=BindingContext.CancelCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                </ScrollView>
            </RefreshView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>