<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TB.DanceDance.Mobile.Library.Data.Models.Storage;assembly=TB.DanceDance.Mobile.Library"
             xmlns:upload="clr-namespace:TB.DanceDance.Mobile.Pages.Upload"
             x:DataType="upload:UploadManagerPageModel"
             x:Class="TB.DanceDance.Mobile.Pages.Upload.UploadManagerPage">
    <ContentPage.Content>
        <Grid Margin="{StaticResource PagePadding}"
              RowDefinitions="Auto,Auto,Auto,*"
              RowSpacing="{StaticResource SpaceMedium}">
            <HorizontalStackLayout Spacing="{StaticResource SpaceSmall}">
                <Switch IsToggled="{Binding UploadOnlyOnWiFi}" />
                <Label Text="Wysyłaj tylko przez WiFi"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Label Text="Postęp wysyłania jest wyświetlany w powiadomieniu. Aplikacja nie ma uprawnienień do ich wyświetlania. Kliknij przycisk aby pozwolić na wyświetlanie powiadomień. (Nie spamujemy :))"
                   Grid.Row="1"
                   IsVisible="{Binding NotificationBlocked}"
                   />
            <Button Grid.Row="2" Text="Ustaw uprawnienia" IsVisible="{Binding NotificationBlocked}" Command="{Binding AskNotificationPermissionsCommand}"/>
            <RefreshView Grid.Row="3"
                         IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}">
                <CollectionView ItemsSource="{Binding ToUpload}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:VideosToUpload">
                            <Border Style="{StaticResource ListCard}">
                                    <VerticalStackLayout Spacing="{StaticResource SpaceSmall}">
                                        <HorizontalStackLayout Spacing="{StaticResource SpaceSmall}"
                                                               VerticalOptions="Center">
                                            <CheckBox IsEnabled="False" IsChecked="{Binding Uploaded}" />
                                            <Label Text="{Binding FileName}" Style="{StaticResource CardTitle}" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding State, StringFormat='Status: {0}'}" />
                                        <Label Text="{Binding LastError}"
                                               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                        <ProgressBar Progress="{Binding Progress}" />
                                        <HorizontalStackLayout Spacing="{StaticResource SpaceSmall}">
                                            <Button Text="Ponów"
                                                    IsVisible="{Binding CanRetry}"
                                                    Command="{Binding RetryCommand, Source={RelativeSource AncestorType={x:Type upload:UploadManagerPageModel}}, x:DataType=upload:UploadManagerPageModel}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Text="Anuluj"
                                                    IsVisible="{Binding CanCancel}"
                                                    Command="{Binding CancelCommand, Source={RelativeSource AncestorType={x:Type upload:UploadManagerPageModel}}, x:DataType=upload:UploadManagerPageModel}"
                                                    CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>
    </ContentPage.Content>
</ContentPage>