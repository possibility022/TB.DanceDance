<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TB.DanceDance.Mobile.Pages.Controls"
             xmlns:pages="clr-namespace:TB.DanceDance.Mobile.Pages"
             x:DataType="pages:MainPageViewModel"
             x:Name="MainPageViewPage"
             x:Class="TB.DanceDance.Mobile.Pages.MainPage">
    <Grid Margin="{StaticResource PagePadding}">
      <VerticalStackLayout VerticalOptions="Center"
                           Spacing="{StaticResource SpaceLarge}">
        <Label
            Text="Cześć!"
            Style="{StaticResource Headline}"
            SemanticProperties.HeadingLevel="Level1" />

        <Label
            Text="Zarejestruj się lub zaloguj :)"
            Style="{StaticResource SubHeadline}"
            SemanticProperties.HeadingLevel="Level2" />

        <ActivityIndicator IsRunning="true" IsVisible="{Binding LoginInProgress}" />

        <controls:FillButton
            Text="Zarejestruj / Zaloguj"
            Command="{Binding LoginCommand}"
            IsEnabled="{Binding LoginEnabled}" />
      </VerticalStackLayout>
    </Grid>

</ContentPage>
