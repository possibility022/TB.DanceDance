<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:access="clr-namespace:TB.DanceDance.Mobile.Pages.Access"
             x:DataType="access:GetAccessPageModel"
             x:Name="GetAccessPageView"
             x:Class="TB.DanceDance.Mobile.Pages.Access.GetAccessPage">
    <ContentPage.Content>
        <Grid Margin="{StaticResource PagePadding}"
              RowDefinitions="*,Auto"
              RowSpacing="{StaticResource SpaceLarge}">
            <RefreshView IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}">
                <CollectionView ItemsSource="{Binding Accesses}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="access:AccessModel">
                            <Border Style="{StaticResource ListCard}">
                                    <VerticalStackLayout Spacing="{StaticResource SpaceSmall}">
                                        <HorizontalStackLayout Spacing="{StaticResource SpaceSmall}">
                                            <Label Text="{Binding TypeAsFriendlyString}"/>
                                            <Label Text="{Binding Season}"/>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Spacing="{StaticResource SpaceSmall}"
                                                               VerticalOptions="Center">
                                            <CheckBox IsEnabled="{Binding CanBeRequested}"
                                                  IsChecked="{Binding IsRequesting, Mode=TwoWay}"
                                                  ></CheckBox>
                                            <Label Text="{Binding Name}" Style="{StaticResource CardTitle}"/>
                                        </HorizontalStackLayout>
                                        <Label Text="Oczekuje na zatwierdzenie"
                                               IsVisible="{Binding IsPending}"
                                               TextColor="{StaticResource Link}"
                                        />
                                    </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
            <Button Grid.Row="1"
                    Text="Uzyskaj Dostęp"
                    Command="{Binding RequestAccessCommand}" />
        </Grid>
    </ContentPage.Content>
</ContentPage>