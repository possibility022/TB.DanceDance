<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TB.DanceDance.Mobile.Pages.Controls"
             xmlns:converters="clr-namespace:TB.DanceDance.Mobile.Converters"
             xmlns:models="clr-namespace:TB.DanceDance.Mobile.Library.Data.Models;assembly=TB.DanceDance.Mobile.Library"
             xmlns:events="clr-namespace:TB.DanceDance.Mobile.Pages.Events"
             x:DataType="events:EventDetailsPageModel"
             x:Class="TB.DanceDance.Mobile.Pages.Events.EventDetailsPage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:NegativeBoolConverter x:Key="InverseBooleanConverter" />
            <converters:DateTimeConverter x:Key="DateTimeConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid Margin="{StaticResource PagePadding}">
                <RefreshView IsRefreshing="{Binding IsRefreshing}"
                             Command="{Binding RefreshCommand}">
                    <CollectionView ItemsSource="{Binding Videos}"
                                    RemainingItemsThreshold="5"
                                    RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Video">
                                <Border Style="{StaticResource VideoCard}" IsEnabled="{Binding Converted}">
                                        <VerticalStackLayout Spacing="0">
                                            <controls:VideoThumbnail
                                                ThumbnailUrl="{Binding ThumbnailUrl}"
                                                HorizontalOptions="Fill" />

                                            <Grid Padding="{StaticResource CardPadding}"
                                                  ColumnSpacing="{StaticResource SpaceSmall}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition></ColumnDefinition>
                                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                                </Grid.ColumnDefinitions>
                                                <VerticalStackLayout Grid.Column="0" Spacing="{StaticResource SpaceXSmall}">
                                                    <Label Text="{Binding Name}" Style="{StaticResource CardTitle}">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer
                                                                Command="{Binding NavigateToWatchVideoCommand, Source={RelativeSource AncestorType={x:Type events:EventDetailsPageModel}}, x:DataType=events:EventDetailsPageModel}"
                                                                CommandParameter="{Binding .}" />
                                                        </Label.GestureRecognizers>
                                                    </Label>
                                                    <Label
                                                        Text="{Binding When, Converter={StaticResource DateTimeConverter}}" />
                                                    <Label Text="Nagranie nie jest gotowe."
                                                           IsVisible="{Binding Converted, Converter={StaticResource InverseBooleanConverter}}"
                                                           TextColor="{StaticResource Link}">
                                                    </Label>
                                                </VerticalStackLayout>

                                                <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center" Spacing="{StaticResource SpaceSmall}">
                                                    <controls:EditButton
                                                                     Command="{Binding RenameVideoCommand, Source={RelativeSource AncestorType={x:Type events:EventDetailsPageModel}}, x:DataType=events:EventDetailsPageModel}"
                                                                     CommandParameter="{Binding Id}" />
                                                    <controls:DeleteButton
                                                                     IsVisible="{Binding IsOwner}"
                                                                     Command="{Binding DeleteVideoCommand, Source={RelativeSource AncestorType={x:Type events:EventDetailsPageModel}}, x:DataType=events:EventDetailsPageModel}"
                                                                     CommandParameter="{Binding Id}" />
                                                </HorizontalStackLayout>
                                            </Grid>
                                        </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.Footer>
                            <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                               IsVisible="{Binding IsLoadingMore}"
                                               Margin="0,12" />
                        </CollectionView.Footer>
                    </CollectionView>
                </RefreshView>
            </Grid>
            <VerticalStackLayout HorizontalOptions="End" VerticalOptions="End">
                <controls:AddVideoButton Command="{Binding NavigateToUploadToEventCommand}"></controls:AddVideoButton>
            </VerticalStackLayout>
        </Grid>
    </ContentPage.Content>
</ContentPage>