<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:events="clr-namespace:TB.DanceDance.Mobile.Pages.Events"
             x:DataType="events:AddEventPageModel"
             x:Name="EventsPageView"
             x:Class="TB.DanceDance.Mobile.Pages.Events.AddEventPage">
    <ContentPage.Content>
        <Grid Margin="{StaticResource PagePadding}"
              RowSpacing="{StaticResource SpaceLarge}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <VerticalStackLayout VerticalOptions="Center" Spacing="{StaticResource SpaceMedium}">
                <Label Text="Nazwa Wydarzenia"/>
                <Entry Text="{Binding EventName}"/>
                
                <Label Text="Data Wydarzenia"/>
                <DatePicker Date="{Binding EventDate}"/>
            </VerticalStackLayout>
            <Button Grid.Row="1" Text="Dodaj" Command="{Binding AddEventCommand}" />
        </Grid>
    </ContentPage.Content>
</ContentPage>