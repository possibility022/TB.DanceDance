<?xml version="1.0" encoding="utf-8" ?>
<Button xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        xmlns:fonts="clr-namespace:TB.DanceDance.Mobile.Resources.Fonts"
        x:Class="TB.DanceDance.Mobile.Pages.Controls.AddEventButton"
        Style="{StaticResource FloatingActionButton}"
        SemanticProperties.Description="Dodaj nowe wydarzenie">
    <Button.ImageSource>
        <FontImageSource Glyph="{x:Static fonts:MaterialIcons.AddEvent}"
                         FontFamily="MaterialRound"
                         Size="24"
                         Color="{StaticResource PrimaryDarkText}" />
    </Button.ImageSource>
</Button>