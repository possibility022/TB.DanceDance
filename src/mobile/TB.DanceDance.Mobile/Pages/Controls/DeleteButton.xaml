<?xml version="1.0" encoding="utf-8" ?>
<ImageButton xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fonts="clr-namespace:TB.DanceDance.Mobile.Resources.Fonts"
             x:Class="TB.DanceDance.Mobile.Pages.Controls.DeleteButton"
             Style="{StaticResource ToolbarIconButton}"
             SemanticProperties.Description="Usuń nagranie">
    <ImageButton.Source>
        <FontImageSource Glyph="{x:Static fonts:MaterialIcons.Delete}"
                         FontFamily="MaterialRound"
                         Size="24"
                         Color="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
    </ImageButton.Source>
</ImageButton>
